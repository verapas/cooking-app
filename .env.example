# Beispiel-Konfiguration für lokales `pnpm dev`.
# Kopieren nach `.env` und Werte anpassen.

# MariaDB-Verbindung (nur bei `pnpm dev` relevant; im Container setzt
# die compose.yaml diese Werte direkt als Umgebung).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cooking
DB_USER=cooking
DB_PASSWORD=devdbpw

# Wo hochgeladene Rezeptbilder gespeichert werden.
IMAGES_DIR=./data/images
