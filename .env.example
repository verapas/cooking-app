# Geheim-Token für schreibende API-Zugriffe (Open Claw) UND gleichzeitig
# das Login-Passwort für den Admin-Modus (Bild-Upload im Browser).
# Bitte einen langen zufälligen String wählen, z.B.:
#   openssl rand -hex 32
COOKING_API_TOKEN=change-me-please

# Wo die SQLite-Datenbankdatei liegt (relativ zum Arbeitsverzeichnis
# des Node-Prozesses). Wird beim ersten Start automatisch angelegt.
DATABASE_PATH=./data/cooking.db

# Wo hochgeladene Rezeptbilder gespeichert werden.
IMAGES_DIR=./data/images
