# =====================================================================
# Koch-App — Env-Vorlage für das ProduktionDeployment
# =====================================================================
# Kopieren nach deploy/.env und alle <change-me>-Werte ersetzen.
# Diese Datei NICHT committen (sie steht in .gitignore).

# --- Öffentliche URL (MUSS gesetzt sein, ohne trailing slash) ---
# Zwingend nötig: ohne ORIGIN lehnt SvelteKits CSRF-Schutz multipart-Uploads
# (Bild-Upload) mit 403 ab, während JSON-Calls durchgehen. Basis der
# OIDC-Redirect-URI.
ORIGIN=https://recipes.lkit.ch

# --- MariaDB-Zugangsdaten (für mariadb- UND app-Service identisch) ---
# DB_NAME/DB_USER werden sowohl beim Initialisieren der DB als auch
# beim Verbinden der App verwendet — müssen übereinstimmen.
DB_NAME=cooking
DB_USER=cooking
DB_PASSWORD=<change-me-starkes-passwort>

# Root-Passwort für den MariaDB-Container (für Wartung/Backups).
MARIADB_ROOT_PASSWORD=<change-me-starkes-passwort>

# --- Login: OIDC/Keycloak (App-Ebene, seit V9 — Pflicht) ---
# Ohne diese drei Werte ist die App fail-closed komplett gesperrt.
# Einrichtung des Keycloak-Clients: INFRA.md (Abschnitt Keycloak).
OIDC_ISSUER=https://auth.lkit.ch/realms/master
OIDC_CLIENT_ID=koch-app
OIDC_CLIENT_SECRET=<change-me-keycloak-client-secret>

# Session-Dauer in Tagen (rolling — verlängert sich bei Aktivität).
# SESSION_TTL_DAYS=30

# --- Optional: Geschützte Konten (/admin) ---
# Kommagetrennte Liste von Benutzernamen ODER numerischen User-IDs, deren
# Konten NICHT gelöscht und nicht degradiert werden können — z. B. den
# Betreiber der Keycloak-/Server-Infrastruktur. In der Admin-UI tragen
# diese Konten ein „geschützt"-Badge, Lösch-/Degradieren-Buttons fehlen.
# Beispiel: PROTECTED_USERS=luca,7
# PROTECTED_USERS=

# --- Optional: Benutzer-Erstellung in der App (/admin, Phase 2) ---
# Service-Account-Client mit Realm-Rolle „realm-management → manage-users"
# (Einrichtung: INFRA.md). Ohne beide Werte ist die Schaltfläche
# „Benutzer erstellen" ausgeblendet — alles andere im Admin-Panel
# funktioniert weiterhin.
# KEYCLOAK_ADMIN_CLIENT_ID=koch-app-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=<change-me-service-account-secret>

# --- Image-Tag (für Watchtower-Synchronisation) ---
# Wird von app-Service als Image-Tag verwendet. Default :edge.
# :latest nur setzen, wenn du per Git-Tag releast.
# APP_TAG=edge

# --- Optional: Port-Override (Default 3000, selten nötig) ---
# PORT=3000
